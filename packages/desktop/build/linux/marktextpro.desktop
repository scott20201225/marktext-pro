[Desktop Entry]
Name=MarkTextPro
Comment=Next generation markdown editor
Exec=marktextpro %F
Terminal=false
Type=Application
Icon=marktextpro
Categories=Office;TextEditor;Utility;
MimeType=text/markdown;text/x-markdown;text/plain;application/vnd.jgraph.mxfile;application/x-drawio;application/vnd.geogebra.file;application/json;application/x-simple-mind-map;
Keywords=marktextpro;
StartupWMClass=marktextpro
Actions=NewWindow;

[Desktop Action NewWindow]
Name=New Window
Exec=marktextpro --new-window %F
Icon=marktextpro
